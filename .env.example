# NapCat / OneBot
NAPCAT_HOST=napcat
NAPCAT_PORT=3001
NAPCAT_TOKEN=replace-me
NAPCAT_CLIENT_TYPE=ws
ADMINS=123456789

# APEX Legends Status: https://apexlegendsapi.com/auth
APEX_AUTH=replace-with-apex-api-key
APEX_ASSET_CACHE_TTL_DAYS=7

# NetEase Cloud Music
NETEASE_API=http://ncm-api:3000

# QQ music-card signing: https://apii.xianyuw.cn/api/qq-musicArk
MUSIC_SIGN_API=https://apii.xianyuw.cn/api/v1/qq-musicArk
MUSIC_SIGN_KEY=replace-with-xianyuw-token

# Group chat AI
NIU_MODEL_PROVIDER=minimax
NIU_MODEL=MiniMax-M3.1-Flash-Preview
NIU_MODEL_BASE_URL=https://api.minimaxi.com/anthropic
NIU_MODEL_API_KEY=replace-with-model-token
MINIMAX_API_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_API_KEY=replace-with-minimax-token
ANYSEARCH_API_KEY=
NIU_TRIGGER_PREFIX=南瓜
NIU_MAX_INPUT_IMAGES=4
NIU_INPUT_IMAGE_MAX_BYTES=5242880
NIU_STICKERS_ENABLED=true
NIU_STICKER_MAX_ITEMS=200
NIU_STICKER_DAILY_UPDATES=30
NIU_STICKER_DAILY_CLASSIFICATIONS=5
NIU_GROUP_HISTORY_ENABLED=true
YASUO_API_URL=http://127.0.0.1:6273
SANDBOX_TOKEN=replace-with-random-sandbox-token
NIU_SANDBOX_TIMEOUT=30
NIU_IMAGE_ENABLED=true
NIU_MUSIC_ENABLED=false

# League of Legends / QIMEI
MLOL_HOST=mlol.qt.qq.com
QIMEI_URL=http://qimei:8080
LOL_ASSET_CACHE_TTL_DAYS=7
