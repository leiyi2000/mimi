# NapCat / OneBot
NAPCAT_HOST=napcat
NAPCAT_PORT=3001
NAPCAT_TOKEN=replace-me
NAPCAT_CLIENT_TYPE=ws
ADMINS=123456789

# APEX Legends Status: https://apexlegendsapi.com/auth
APEX_AUTH=replace-with-apex-api-key
APEX_ASSET_CACHE_TTL_DAYS=7

# NetEase Cloud Music
NETEASE_API=http://ncm-api:3000

# QQ music-card signing: https://apii.xianyuw.cn/api/qq-musicArk
MUSIC_SIGN_API=https://apii.xianyuw.cn/api/v1/qq-musicArk
MUSIC_SIGN_KEY=replace-with-xianyuw-token

# Pumpkin AI
# Also used as the group-chat wake prefix.
PUMPKIN_ASSISTANT_NAME=replace-with-assistant-name
PUMPKIN_MODEL_BASE_URL=https://replace-with-openai-compatible-endpoint/v1
PUMPKIN_MODEL_API_KEY=replace-with-model-token
PUMPKIN_CHAT_MODEL=replace-with-chat-model
PUMPKIN_TASK_MODEL=replace-with-task-model
PUMPKIN_CHAT_REASONING_EFFORT=low
PUMPKIN_TASK_REASONING_EFFORT=max
PUMPKIN_CHAT_MAX_TOKENS=4096
PUMPKIN_TASK_MAX_TOKENS=8192
PUMPKIN_SESSION_TTL_SECONDS=900
PUMPKIN_CHAT_TIMEOUT_SECONDS=15
PUMPKIN_TASK_TIMEOUT_SECONDS=90
PUMPKIN_SINGLE_TASK_TIMEOUT_SECONDS=900
PUMPKIN_MAX_STEPS=36
# Optional web search. Leave empty until a real provider key is provisioned.
PUMPKIN_SEARCH_API_URL=https://api.anysearch.com/v1/search
PUMPKIN_SEARCH_API_KEY=
PUMPKIN_SEARCH_TIMEOUT_SECONDS=10
PUMPKIN_FETCH_MAX_BYTES=1048576
PUMPKIN_IMAGE_FETCH_MAX_BYTES=5242880
# Code execution is handled by the internal code-runner Compose service.
PUMPKIN_CODE_RUNNER_URL=http://code-runner:8080
PUMPKIN_CODE_RUNNER_TOKEN=
PUMPKIN_CODE_TIMEOUT_SECONDS=20
# Optional image generation provider.
PUMPKIN_IMAGE_PROVIDER=
PUMPKIN_IMAGE_API_BASE_URL=
PUMPKIN_IMAGE_API_KEY=
PUMPKIN_IMAGE_MODEL=image-01
PUMPKIN_IMAGE_TIMEOUT_SECONDS=90
# Optional audio generation provider.
PUMPKIN_AUDIO_PROVIDER=
PUMPKIN_AUDIO_API_BASE_URL=
PUMPKIN_AUDIO_API_KEY=
PUMPKIN_AUDIO_MODEL=speech-2.8-hd
PUMPKIN_AUDIO_TIMEOUT_SECONDS=90
PUMPKIN_AUDIO_MAX_TEXT_CHARS=10000
# Optional speech-to-text provider for inspecting inbound voice messages.
PUMPKIN_AUDIO_TRANSCRIBE_PROVIDER=minimax
PUMPKIN_AUDIO_TRANSCRIBE_BASE_URL=https://api.minimax.cn
PUMPKIN_AUDIO_TRANSCRIBE_API_KEY=
PUMPKIN_AUDIO_TRANSCRIBE_MODEL=asr-1.0
# Media inspection downloads referenced images only when the model requests them.
PUMPKIN_MEDIA_TIMEOUT_SECONDS=10
PUMPKIN_MEDIA_MAX_BYTES=5242880

# League of Legends / QIMEI
MLOL_HOST=mlol.qt.qq.com
QIMEI_URL=http://qimei:8080
LOL_ASSET_CACHE_TTL_DAYS=7
